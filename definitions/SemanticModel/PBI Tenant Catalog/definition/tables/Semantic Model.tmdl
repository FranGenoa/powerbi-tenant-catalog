/// One row per semantic model (dataset) in the tenant.
table 'Semantic Model'
	lineageTag: 6c38e200-380c-4c84-b864-c721b2bbdbbe

	/// Number of semantic models (datasets) in the current filter context.
	measure 'Semantic Models' = COUNTROWS ( 'Semantic Model' )
		formatString: #,##0
		displayFolder: Inventory
		lineageTag: 3c5e6f8e-f6b4-4f96-bf0e-349d71e2b0de

	/// Semantic models endorsed as Certified.
	measure 'Certified Models' = CALCULATE ( [Semantic Models], 'Semantic Model'[Endorsement] = "Certified" )
		formatString: #,##0
		displayFolder: Governance
		lineageTag: 4dc78334-aa60-4f89-b84b-9f67c8d89339

	/// Semantic models endorsed as Promoted.
	measure 'Promoted Models' = CALCULATE ( [Semantic Models], 'Semantic Model'[Endorsement] = "Promoted" )
		formatString: #,##0
		displayFolder: Governance
		lineageTag: 43600988-02ad-441d-9cee-8ddda2eade7b

	/// Share of semantic models that carry a Certified or Promoted endorsement.
	measure 'Endorsed Models %' = DIVIDE ( [Certified Models] + [Promoted Models], [Semantic Models] )
		formatString: 0.0%
		displayFolder: Governance
		lineageTag: f8f02f3c-f2a8-4681-b025-cbb001f537e6

	/// Semantic models that no report is built on - candidates for retirement.
	measure 'Models without Reports' =
			SUMX (
			    VALUES ( 'Semantic Model'[Semantic Model Key] ),
			    IF ( ISBLANK ( CALCULATE ( COUNTROWS ( 'Report' ) ) ), 1, 0 )
			)
		formatString: #,##0
		displayFolder: Governance
		lineageTag: c292bde8-04e1-4ffd-902d-ac3b729500b2

	/// Distinct users or service principals that own semantic models.
	measure 'Distinct Model Owners' = DISTINCTCOUNT ( 'Semantic Model'[Configured By] )
		formatString: #,##0
		displayFolder: Governance
		lineageTag: fbddabea-a5ff-4c65-8aec-c377704c3a92

	/// Average number of tables per semantic model.
	measure 'Tables per Model' = DIVIDE ( [Model Tables], [Semantic Models] )
		formatString: #,##0.0
		displayFolder: Complexity
		lineageTag: 97436673-ae56-4733-abd1-39ac21056ec5

	/// Average number of measures per semantic model.
	measure 'Measures per Model' = DIVIDE ( [Measures], [Semantic Models] )
		formatString: #,##0.0
		displayFolder: Complexity
		lineageTag: 7d6a176c-28a5-4d3c-a4f8-7ddc4e8f3dd0

	/// Average number of columns per semantic model.
	measure 'Columns per Model' = DIVIDE ( [Columns], [Semantic Models] )
		formatString: #,##0.0
		displayFolder: Complexity
		lineageTag: dca0bfeb-e0a6-402e-bf1d-c1b678ec3917

	/// Average number of reports built on each semantic model.
	measure 'Reports per Model' = DIVIDE ( [Reports], [Semantic Models] )
		formatString: #,##0.0
		displayFolder: Complexity
		lineageTag: 6eff18ff-aa4f-4fc3-afeb-a5600bf5d0a7

	column 'Semantic Model Key'
		dataType: int64
		isHidden
		lineageTag: 3b1047c1-187a-4884-b546-7861f5d4ed38
		summarizeBy: none
		sourceColumn: semanticModelKey

	column 'Workspace Key'
