/// One row per report (Power BI or paginated) in the tenant.
table Report
	lineageTag: 2f2ec360-c7a2-4784-9dc6-78cbd5da7193

	/// Number of reports in the current filter context.
	measure Reports = COUNTROWS ( 'Report' )
		formatString: #,##0
		displayFolder: Inventory
		lineageTag: 1a0f95b6-a1f0-41f8-b494-adda07f41732

	/// Reports whose semantic model was not found in the scan - broken or cross-workspace bindings.
	measure 'Orphan Reports' =
			CALCULATE (
			    [Reports],
			    FILTER ( 'Report', ISBLANK ( RELATED ( 'Semantic Model'[Semantic Model Name] ) ) )
			)
		formatString: #,##0
		displayFolder: Governance
		lineageTag: f9afbd4c-e787-40de-aa3f-69b832cfaafb

	/// Paginated (RDL) reports.
	measure 'Paginated Reports' = CALCULATE ( [Reports], 'Report'[Report Type] = "PaginatedReport" )
		formatString: #,##0
		displayFolder: Inventory
		lineageTag: 8f7abcf3-97fb-4b02-a731-c4150458710a

	/// Reports modified in the last 90 days.
	measure 'Reports Modified Last 90 Days' = CALCULATE ( [Reports], DATESINPERIOD ( 'Date'[Date], TODAY (), -90, DAY ) )
		formatString: #,##0
		displayFolder: Adoption
		lineageTag: 7266065f-120b-4896-8560-0ead399f5223

	/// Reports not modified for more than 180 days - candidates for review or retirement.
	measure 'Stale Reports' =
			CALCULATE (
			    [Reports],
			    KEEPFILTERS ( FILTER ( ALL ( 'Date'[Date] ), 'Date'[Date] < TODAY () - 180 ) )
			)
		formatString: #,##0
		displayFolder: Adoption
		lineageTag: 10629006-11a6-435b-8ce6-29f8f64606d1

	/// Share of reports not modified for more than 180 days.
	measure 'Stale Reports %' = DIVIDE ( [Stale Reports], [Reports] )
		formatString: 0.0%
		displayFolder: Adoption
		lineageTag: b7f29f6d-f788-4ff0-a1b7-7e57bd49e53b

	/// Most recent report modification date in scope.
	measure 'Last Report Change' = MAX ( 'Report'[Modified Date Time] )
		formatString: yyyy-mm-dd
		displayFolder: Adoption
		lineageTag: f203a1fd-90e8-4817-a083-704d78cec045

	/// Distinct principals that last modified a report.
	measure 'Distinct Report Authors' = DISTINCTCOUNT ( 'Report'[Modified By] )
		formatString: #,##0
		displayFolder: Adoption
		lineageTag: 2a6f73bf-b32d-4ce2-ad1f-a04d9b2f8995

	column 'Workspace Key'
